(version 1)
# header-option 0 ohm links share the FX3-side pad of the fitted link (usb.py, D-70)
(rule "shared-pad 0 ohm selectors"
  (condition "(A.Reference == 'R30' && B.Reference == 'R31') || (A.Reference == 'R32' && B.Reference == 'R33') || (A.Reference == 'R34' && B.Reference == 'R35') || (A.Reference == 'R36' && B.Reference == 'R37') || (A.Reference == 'R38' && B.Reference == 'R39') || (A.Reference == 'R40' && B.Reference == 'R41')")
  (constraint courtyard_clearance (min -1mm)))
# JLCPCB (4 layers, 1 oz outer) limits that KiCad's global settings do not cover
(rule "free-size vias everywhere else (JLC 4 layers: 0.3 mm hole, 0.45 mm diameter)"
  (condition "A.Type == 'Via' && A.Hole >= 0.2mm")
  (constraint hole_size (min 0.3mm))
  (constraint via_diameter (min 0.45mm)))
(rule "no small vias (paid option; D-73 replaced the USB-C that needed them)"
  (condition "A.Type == 'Via' && A.Hole < 0.2mm")
  (constraint disallow via))
(rule "pad hole to pad hole (JLC 0.45 mm)"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
  (constraint hole_to_hole (min 0.45mm)))
# the USB-C's row-B sub-rows are staggered 0.81 mm apart (maker's layout,
# 0.40 mm drills): checked with JLC at ordering (D-73)
(rule "USB-C row B (maker's layout)"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == 'J3' && B.Parent == 'J3'")
  (constraint hole_to_hole (min 0.35mm))
  (constraint clearance (min 0.1mm)))
(rule "USB-C locating holes (maker's layout)"
  (condition "A.Parent == 'J3'")
  (constraint edge_clearance (min 0.2mm)))
(rule "BGA fan-out (JLC allows 0.09 mm near BGA pads)"
  (condition "A.intersectsCourtyard('U1')")
  (constraint clearance (min 0.09mm)))
# webs of the In2 +1V2 plane between the 0.8 mm-pitch fan-out vias (D-71):
# 0.8 - 0.45 - 2 x 0.12 = 0.11 mm >= the island's 0.1 mm minimum width
# tracks between the 0.8 mm-pitch fan-out vias: a centred 0.1 mm track keeps
# exactly 0.2 mm from the 0.3 mm holes, the router's tracks sit up to 0.025 mm
# off centre (autoroute.py, D-74); checked with JLC's DFM at ordering
(rule "BGA fan-out hole clearance"
  (condition "A.intersectsCourtyard('U1') || B.intersectsCourtyard('U1')")
  (constraint hole_clearance (min 0.17mm)))
(rule "planes between the BGA fan-out vias"
  (condition "(A.Type == 'Zone' && B.intersectsCourtyard('U1')) || (B.Type == 'Zone' && A.intersectsCourtyard('U1'))")
  (constraint clearance (min 0.12mm)))
(rule "RF 75 ohm keeps copper pours away"
  (condition "A.NetClass == 'RF_75' && B.Type == 'Zone'")
  (constraint clearance (min 0.45mm)))
